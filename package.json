{
  "name": "dsh-plugin-catalog",
  "version": "0.25.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件/Skill 目录面板：卡片式列出全部插件与 Skill（官方/自写/第三方/混血四分类）、按会话日志统计 90 天内每个工具的调用次数/报错/耗时/涉及会话（子代理单独标记）、自定义标签 + AI 分类、每周缺口分析与安全审核、自写与混血一键备份到 GitHub 私有仓（双语 README，密钥命中即停）。官方插件入口保留不隐藏。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
